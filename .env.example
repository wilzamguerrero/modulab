# Copia este archivo a `.env` (desarrollo local, Express) y `.dev.vars`
# (Cloudflare Pages, `wrangler pages dev`). Ambos están en .gitignore.
#
# NUNCA pongas estas credenciales en `src/` ni en variables con prefijo VITE_:
# acabarían dentro del bundle del navegador.

# --- Notion (obligatorio para conectar) ------------------------------------
# Integración pública creada en https://www.notion.so/my-integrations
# Las URIs de retorno deben estar registradas en la integración y coincidir
# exactamente. Las de este proyecto son la raíz del sitio, no una ruta propia:
#   http://localhost:3000/
#   https://modulabd.pages.dev/
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Opcional: URIs de retorno adicionales, separadas por comas.
NOTION_REDIRECT_URI=

# --- Compatibilidad (desuso) -----------------------------------------------
# Solo se leen si NO hay credenciales OAuth. Con OAuth configurado se ignoran:
# la conexión sale del token que se autoriza desde la interfaz.
# NOTION_SECRET=
# NOTION_ID_PAGE=

PORT=3000
# Opcional: carpeta de datos del servidor (por defecto, ./data)
MODULAB_DATA_DIR=
